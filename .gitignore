# Local runtime outputs and audit artifacts.
# `reports/` has a fixed root layout. Keep generated outputs on disk, but do
# not add routine reports/logs/databases to Git. Only curated governance
# archives are versioned so research decisions can be audited from main.
logs/
!logs/
logs/*
!logs/README.md
memory/
!memory/
!memory/**/
!memory/**/*.md
!memory/**/*.txt
reports/*
!reports/README.md

# Root report categories. The category directories are visible on main via
# `.gitkeep`, while their generated contents stay local unless explicitly
# unignored below.
!reports/archive/
reports/archive/*
!reports/archive/.gitkeep
!reports/database_health/
reports/database_health/*
!reports/database_health/.gitkeep
!reports/phase0/
reports/phase0/*
!reports/phase0/.gitkeep
!reports/runs/
reports/runs/*
!reports/runs/.gitkeep
!reports/strategy_admission/
reports/strategy_admission/*
!reports/strategy_admission/.gitkeep

# Strategy governance is the only reports subtree intended for versioned
# research records. Keep human-readable summaries and briefings; leave bulk
# machine outputs local unless force-added intentionally.
!reports/strategy_governance/
!reports/strategy_governance/**/
reports/strategy_governance/**/*.csv
reports/strategy_governance/**/*.json
reports/strategy_governance/**/*.parquet
reports/strategy_governance/**/*.png
reports/strategy_governance/**/*.svg
!reports/strategy_governance/**/*.md
!reports/strategy_governance/**/*.html
*.sqlite
*.sqlite-*
*.db
*.db-*

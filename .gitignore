# Local runtime outputs and audit artifacts.
# `reports/` has a fixed root layout. Keep generated outputs on disk, but do
# not add routine reports/logs/databases to the origin repository.
logs/
!logs/
logs/*
!logs/README.md
memory/
reports/*
!reports/README.md

# Root report categories. The category directories are visible on main via
# `.gitkeep`, while their generated contents stay local unless explicitly
# unignored below.
!reports/archive/
reports/archive/*
!reports/archive/.gitkeep
!reports/database_health/
reports/database_health/*
!reports/database_health/.gitkeep
!reports/phase0/
reports/phase0/*
!reports/phase0/.gitkeep
!reports/runs/
reports/runs/*
!reports/runs/.gitkeep
!reports/strategy_admission/
reports/strategy_admission/*
!reports/strategy_admission/.gitkeep

# Strategy governance reports are local runtime/research artifacts in this
# origin repository. Other repository copies may force-add their own report
# records if they intentionally maintain a separate tracking policy.
!reports/strategy_governance/
reports/strategy_governance/*
!reports/strategy_governance/.gitkeep
*.sqlite
*.sqlite-*
*.sqlite.bak-*
*.db
*.db-*
.DS_Store
